DATABASE_URL=postgres://yb:yb_dev_password@localhost:5433/yb_travel
PORT=3001
JWT_SECRET=dev-only-secret-change-me-please-1234567890
# During a planned JWT rotation, move the former value here for one token
# lifetime, separated by commas if needed; then remove it.
JWT_SECRET_PREVIOUS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_LOCK_MINUTES=15
# Required before an administrator can save an AI provider API key.
# Generate a dedicated 32-byte key with: openssl rand -base64 32
AI_SECRETS_ENCRYPTION_KEY=
# Temporary grace keys for decrypting and re-encrypting stored provider
# credentials during rotation. Remove after POST /ai-provider-settings/rotate-secret.
AI_SECRETS_ENCRYPTION_KEY_PREVIOUS=
# Dedicated base64-encoded 32-byte key for encrypted database backups.
BACKUP_ENCRYPTION_KEY=
# Local Docker Compose and any deployment without matching host PostgreSQL tools:
POSTGRES_TOOL_DOCKER_SERVICE=postgres
