{
  "name": "@yb-travel/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:messaging": "npm run build && node scripts/test-start-conversation.js",
    "test:assignment": "npm run build && node scripts/test-request-assignment.js",
    "test:clients": "npm run build && node scripts/test-client-duplicate-prevention.js",
    "test:test-data-reset": "npm run build && node scripts/test-test-data-reset.js",
    "test:whatsapp-disconnect": "npm run build && node scripts/test-whatsapp-disconnect.js",
    "test:whatsapp-accounts": "npm run build && node scripts/test-whatsapp-accounts.js",
    "test:voice-notes": "npm run build && node scripts/test-voice-notes.js",
    "test:onboarding": "npm run build && node scripts/test-onboarding-completeness.js",
    "test:phase1-records": "npm run build && node scripts/test-phase1-fees-templates-records.js",
    "test:security": "npm run build && node scripts/test-security.js",
    "auth:reset-local-password": "node scripts/reset-local-password.js",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "node scripts/backup.js",
    "db:verify-backup": "node scripts/verify-backup.js",
    "db:restore": "node scripts/restore.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@whiskeysockets/baileys": "^6.7.16",
    "@yb-travel/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.7.3"
  }
}
